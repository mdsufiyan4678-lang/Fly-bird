# Port for HTTP REST API and WebSocket upgrade listener
PORT=8080

# SQLite database file path for persistent online leaderboards and 2P match results
DB_PATH=./data/flybird.sqlite

# Abandoned room cleanup timeout in milliseconds (default: 5 minutes)
ROOM_IDLE_TIMEOUT_MS=300000

# Player reconnect grace window in milliseconds (default: 30 seconds)
RECONNECT_GRACE_MS=30000

# Maximum plausible score rate (pipes per second) for server-side anti-cheat validation
MAX_PIPES_PER_SECOND=1.15
