# MULTIPLAYER_WS_URL: WebSocket URL for the standalone Node.js multiplayer server.
# Replace with your deployed server domain (e.g., wss://flybird-server.onrender.com)
# or local LAN address during testing (e.g., ws://192.168.1.100:8080).
MULTIPLAYER_WS_URL=wss://YOUR_SERVER_DOMAIN

# MULTIPLAYER_HTTP_URL: HTTP/HTTPS base URL for online leaderboard REST endpoints.
MULTIPLAYER_HTTP_URL=https://YOUR_SERVER_DOMAIN

# ADMOB_BANNER_AD_UNIT_ID: Google AdMob Banner Ad Unit ID.
ADMOB_BANNER_AD_UNIT_ID=ca-app-pub-1238798127993304/8249308413

# ADMOB_REWARDED_AD_UNIT_ID: Google AdMob Rewarded Ad Unit ID.
ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-1238798127993304/1683900062
